                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/franklin/components/block/v1/block"
                    aueComponentId="richtext"
                    ctaText="Request a Demo"
                    ctaUrl="/content/my-dxp-site/contact"
                    heading="What is a Digital Experience Platform?"
                    lead="A DXP is a platform that enables organizations to deliver personalized, consistent, and engaging digital experiences across all customer touchpoints."
                    model="richtext-block"
                    modelFields="[overline@text,heading@text,lead@text,text@richtext,sidebarTitle@text,sidebarText@richtext,ctaUrl@aem-content,ctaText@text]"
                    name="Richtext"
                    overline="Platform Knowledge Base"
                    sidebarText="&lt;p>Get a personalized walkthrough of ZensAI capabilities with one of our platform experts.&lt;/p>"
                    sidebarTitle="See DXP AI in Action"
                    text="&lt;p>A &lt;strong>Digital Experience Platform (DXP)&lt;/strong> is a unified technology platform used by organizations to create, manage, deliver, and optimize digital experiences across multiple channels — such as websites, mobile apps, portals, chatbots, and email.&lt;/p>&lt;p>Think of it as the central hub that connects content, data, personalization, analytics, and integrations to deliver a consistent and engaging user experience at every touchpoint.&lt;/p>&lt;h3>What Does a DXP Do?&lt;/h3>&lt;ol>&lt;li>&lt;strong>Content Management&lt;/strong> — Create and manage digital content with role-based authoring and approvals.&lt;/li>&lt;li>&lt;strong>Personalized Experiences&lt;/strong> — Deliver personalized content based on user behavior, profile, or context.&lt;/li>&lt;li>&lt;strong>Multi-Channel Delivery&lt;/strong> — Serve content across websites, mobile apps, portals, and headless APIs.&lt;/li>&lt;li>&lt;strong>Integration Hub&lt;/strong> — Connect with Salesforce CRM, SAP ERP, and marketing automation platforms.&lt;/li>&lt;li>&lt;strong>Analytics &amp;amp; Insights&lt;/strong> — Track user behavior, measure content performance, and optimize based on data.&lt;/li>&lt;li>&lt;strong>AI-Powered Capabilities&lt;/strong> — AI-driven search, content generation, intelligent recommendations, and conversational AI.&lt;/li>&lt;/ol>"/>
            </section_8>
