                    <item_0
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        heading="Headless / API-First Delivery"
                        model="cms-compat-approach"
                        name="CMS Compat Approach"
                        text="&lt;p>Decouple your front-end from content and experience back-end. Power any modern framework — React, Next.js, Vue, mobile apps, or IoT — via ZensAI GraphQL and REST APIs.&lt;/p>&lt;ul>&lt;li>GraphQL &amp;amp; REST content delivery APIs&lt;/li>&lt;li>SDKs for React, Next.js, Vue, Angular&lt;/li>&lt;li>Edge CDN with instant cache invalidation&lt;/li>&lt;li>AI-enriched API responses&lt;/li>&lt;li>Preview API for any front-end framework&lt;/li>&lt;/ul>"/>
                    <item_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        heading="Headful / Full-Stack Delivery"
                        model="cms-compat-approach"
                        name="CMS Compat Approach"
                        text="&lt;p>Use DXP AI built-in rendering engine to manage the full experience — from content authoring to page building to delivery — without a separate front-end application.&lt;/p>&lt;ul>&lt;li>Drag-and-drop visual page builder&lt;/li>&lt;li>Built-in multi-site &amp;amp; multi-language support&lt;/li>&lt;li>Server-side rendering &amp;amp; static site generation&lt;/li>&lt;li>Live preview &amp;amp; in-context editing&lt;/li>&lt;li>One-click deployment to global CDN&lt;/li>&lt;/ul>"/>
                </cms_compat>
