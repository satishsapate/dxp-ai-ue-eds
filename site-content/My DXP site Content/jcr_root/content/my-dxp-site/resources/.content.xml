                    <item_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="AI-First DXP Buyer&apos;s Guide"
                        text="&lt;p&gt;A practical evaluation framework for digital experience platform selection. Covers 40 capability criteria, vendor comparison methodology, RFP template, and a scoring model you can adapt to your organization&apos;s specific requirements.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Format:&lt;/strong&gt; PDF Guide + Excel Scorecard&lt;/p&gt;"
                        ctaText="Download Guide"
                        ctaUrl="/content/my-dxp-site/contact"/>
                    <item_2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="ROI Calculator &amp; Business Case Template"
                        text="&lt;p&gt;Build a compelling business case for DXP AI with our interactive ROI calculator and executive presentation template. Covers cost savings, revenue impact, content production efficiency, and risk reduction &#8212; pre-filled with industry benchmarks.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Format:&lt;/strong&gt; Excel Calculator + PowerPoint Template&lt;/p&gt;"
                        ctaText="Download Tools"
                        ctaUrl="/content/my-dxp-site/contact"/>
                </features>
