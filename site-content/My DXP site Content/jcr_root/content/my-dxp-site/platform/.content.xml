                    breadcrumbCurrent="Platform"
                    breadcrumbUrl="/content/my-dxp-site/index"
                    description="&lt;p>DXP AI brings together content management, personalization, multi-channel delivery, analytics, and AI capabilities into a single, composable platform — powered by ZensAI.&lt;/p>"
