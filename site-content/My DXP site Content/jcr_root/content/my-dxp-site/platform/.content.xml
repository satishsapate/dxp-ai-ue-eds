                    name="Section Dark"
                    heading="Composable &amp; Cloud-Native by Design"
                    text="&lt;p&gt;Deploy headless, hybrid, or traditional &#8212; DXP AI adapts to your architecture, not the other way around.&lt;/p&gt;"/>
                <features_arch
                    jcr:created="{Date}2026-05-19T20:30:00.000Z"
