                    <item_0
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        heading="Headless &amp; Composable"
                        model="features-item"
                        name="Features Item"
                        text="&lt;p>Decouple front-end from back-end. Serve content via GraphQL or REST to any framework — Next.js, React, Vue, or native mobile apps.&lt;/p>"/>
                    <item_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        heading="Multi-Cloud Ready"
                        model="features-item"
                        name="Features Item"
                        text="&lt;p>Deploy on AWS, Azure, or GCP. Auto-scaling, containerized microservices, and 99.9% uptime SLA backed by global CDN edge nodes.&lt;/p>"/>
                    <item_2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        heading="Enterprise-Grade Security"
                        model="features-item"
                        name="Features Item"
                        text="&lt;p>SOC 2 Type II, ISO 27001, GDPR, HIPAA-ready. Role-based access control, encryption at rest and in transit, audit logging.&lt;/p>"/>
                </features_arch>
            </section_3>
