                    model="section-dark"
                    modelFields="[heading@text,text@richtext]"
                    name="Section Dark"
                    text="&lt;p>Deploy headless, hybrid, or traditional — DXP AI adapts to your architecture, not the other way around.&lt;/p>"/>
                <features_arch
                    jcr:created="{Date}2026-05-19T20:30:00.000Z"
