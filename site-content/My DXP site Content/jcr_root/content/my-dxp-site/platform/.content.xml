                    breadcrumbCurrent="Platform"
                    badgeText="Platform Overview"
                    headingPrefix="One AI-Native Platform."
                    headingAccent="Every Digital Experience."
                    description="&lt;p&gt;DXP AI brings together content management, personalization, multi-channel delivery, analytics, and AI capabilities into a single, composable platform &#8212; powered by ZensAI.&lt;/p&gt;"/>
            </section>
            <section_2
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/franklin/components/section/v1/section">
                <features
                    jcr:created="{Date}2026-05-19T20:30:00.000Z"
                    jcr:createdBy="satish.sapate@zensar.com"
                    jcr:lastModified="{Date}2026-05-19T20:30:00.000Z"
                    jcr:lastModifiedBy="satish.sapate@zensar.com"
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/franklin/components/block/v1/block"
                    aueComponentId="features"
                    filter="features"
                    name="Features">
                    <item_0
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="AI Content Management"
                        text="&lt;p&gt;Create, manage, and reuse structured and unstructured content across every channel with AI-assisted authoring, smart tagging, and workflow automation.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;WYSIWYG and structured content editors&lt;/li&gt;&lt;li&gt;AI-assisted copywriting &amp;amp; summarization&lt;/li&gt;&lt;li&gt;Role-based authoring &amp;amp; multi-step approval&lt;/li&gt;&lt;li&gt;Digital Asset Management (DAM)&lt;/li&gt;&lt;li&gt;Headless content via GraphQL &amp;amp; REST APIs&lt;/li&gt;&lt;/ul&gt;"/>
                    <item_1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="Personalization Engine"
                        text="&lt;p&gt;Serve hyper-relevant content to every visitor in real time using ML-driven segmentation, behavioral targeting, and intelligent recommendations.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Real-time behavioral profiling&lt;/li&gt;&lt;li&gt;Rule-based &amp;amp; ML-driven segments&lt;/li&gt;&lt;li&gt;A/B, multivariate &amp;amp; bandit testing&lt;/li&gt;&lt;li&gt;Contextual recommendations engine&lt;/li&gt;&lt;li&gt;Progressive user profile enrichment&lt;/li&gt;&lt;/ul&gt;"/>
                    <item_2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="Multi-Channel Delivery"
                        text="&lt;p&gt;Deliver consistent, high-performance experiences to websites, mobile apps, portals, voice interfaces, and headless frontends &#8212; all from one source of truth.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Web, mobile &amp;amp; PWA delivery&lt;/li&gt;&lt;li&gt;Customer, employee &amp;amp; partner portals&lt;/li&gt;&lt;li&gt;Headless &amp;amp; composable APIs&lt;/li&gt;&lt;li&gt;Edge CDN with global distribution&lt;/li&gt;&lt;li&gt;Email, push &amp;amp; in-app notification delivery&lt;/li&gt;&lt;/ul&gt;"/>
                    <item_3
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="ZensAI Intelligence"
                        text="&lt;p&gt;The AI brain of the platform &#8212; powering intelligent search, conversational interfaces, predictive analytics, and automated content operations.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Semantic AI-driven search&lt;/li&gt;&lt;li&gt;Conversational AI &amp;amp; virtual agents&lt;/li&gt;&lt;li&gt;Content generation &amp;amp; summarization&lt;/li&gt;&lt;li&gt;Predictive lead &amp;amp; content scoring&lt;/li&gt;&lt;li&gt;Automated tagging &amp;amp; classification&lt;/li&gt;&lt;/ul&gt;"/>
                    <item_4
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="Analytics &amp; Insights"
                        text="&lt;p&gt;Understand every interaction with real-time dashboards, funnel analysis, and AI-powered insights that help you continuously optimize experiences.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Real-time engagement dashboards&lt;/li&gt;&lt;li&gt;Content performance &amp;amp; conversion tracking&lt;/li&gt;&lt;li&gt;Audience segmentation reports&lt;/li&gt;&lt;li&gt;Custom KPI dashboards&lt;/li&gt;&lt;li&gt;Data export &amp;amp; BI integrations&lt;/li&gt;&lt;/ul&gt;"/>
                    <item_5
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/franklin/components/block/v1/block/item"
                        model="features-item"
                        name="Features Item"
                        heading="Integration Hub"
                        text="&lt;p&gt;Connect DXP AI to your entire enterprise ecosystem &#8212; CRM, ERP, marketing automation, analytics tools, and more &#8212; via open APIs and pre-built connectors.&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Salesforce, SAP, Microsoft Dynamics&lt;/li&gt;&lt;li&gt;Marketo, HubSpot, Pardot&lt;/li&gt;&lt;li&gt;50+ pre-built enterprise connectors&lt;/li&gt;&lt;li&gt;RESTful APIs &amp;amp; webhooks&lt;/li&gt;&lt;li&gt;Custom connector SDK&lt;/li&gt;&lt;/ul&gt;"/>
                </features>
            </section_2>
            <section_3
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/franklin/components/section/v1/section">
                <section_dark
